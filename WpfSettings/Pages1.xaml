<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:HoverExplorer.Wpf;assembly=HoverExplorer">

    <!-- ============ 预览列表 ============ -->
    <DataTemplate x:Key="TriggerPage">
        <StackPanel>
            <HeaderedContentControl Header="触发" c:Cfg.I18n="group_trigger" Style="{DynamicResource Card}">
                <StackPanel>
                    <c:SettingRow c:Cfg.I18n="hotkey_row" c:Cfg.Desc="hotkey_desc">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton c:Cfg.Key="HotkeyEnabled" Style="{DynamicResource Switch}" Margin="0,0,10,0"/>
                            <!-- 键帽组：点击重新录制，× 清除 -->
                            <Border Style="{DynamicResource KeyCapGroup}" c:Cfg.ShowIf="HotkeyOn" c:Cfg.Action="hk:main:reset">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{DynamicResource KeyCap}"><TextBlock c:Cfg.Key="HkMain:0" Text="Ctrl" HorizontalAlignment="Center"/></Border>
                                    <Border Style="{DynamicResource KeyCap}"><TextBlock c:Cfg.Key="HkMain:1" Text="Alt" HorizontalAlignment="Center"/></Border>
                                    <Border Style="{DynamicResource KeyCap}"><TextBlock c:Cfg.Key="HkMain:2" Text="Q" HorizontalAlignment="Center"/></Border>
                                    <Button Style="{DynamicResource KeyCapClear}" c:Cfg.Action="hk:main:del"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="pause_zone_row" c:Cfg.Key="PauseRectInfo">
                        <StackPanel Orientation="Horizontal">
                            <Button c:Cfg.I18n="area_clear" c:Cfg.Action="pause:clear" Margin="0,0,6,0"/>
                            <Button c:Cfg.I18n="area_pick" c:Cfg.Action="pause:pick"/>
                        </StackPanel>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="pause_delay_row" c:Cfg.Desc="pause_delay_desc" c:Cfg.ShowIf="PauseRectSet">
                        <c:Stepper c:Cfg.Key="PauseRectDelayMs" Value="200" Min="0" Max="2000" Step="50" Suffix=" ms"/>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="delay_row" c:Cfg.Desc="hover_delay_desc">
                        <c:Stepper c:Cfg.Key="HoverDelay" Value="0.3" Min="0" Max="5" Step="0.05" Format="0.00" Suffix=" 秒"/>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="explorer_hover" c:Cfg.Desc="mode_desc">
                        <ComboBox c:Cfg.Key="ExplorerMode" SelectedIndex="0">
                            <ComboBoxItem c:Cfg.I18n="mode_off"/>
                            <ComboBoxItem c:Cfg.I18n="mode_always"/>
                            <ComboBoxItem c:Cfg.I18n="mode_ctrl"/>
                            <ComboBoxItem c:Cfg.I18n="mode_shift"/>
                            <ComboBoxItem c:Cfg.I18n="mode_alt"/>
                            <ComboBoxItem c:Cfg.I18n="mode_long_press"/>
                        </ComboBox>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="pv_folder_edge" c:Cfg.Desc="pv_folder_edge_desc">
                        <ComboBox c:Cfg.Key="FolderEdgeMode" SelectedIndex="0">
                            <ComboBoxItem c:Cfg.I18n="edge_off"/>
                            <ComboBoxItem c:Cfg.I18n="edge_left"/>
                            <ComboBoxItem c:Cfg.I18n="edge_right"/>
                            <ComboBoxItem c:Cfg.I18n="edge_both"/>
                        </ComboBox>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="pv_edge_width" c:Cfg.ShowIf="FolderEdgeOn"><c:Stepper c:Cfg.Key="FolderEdgeWidth" Value="48" Min="10" Max="300" Step="5" Suffix=" px"/></c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="icon_trigger" c:Cfg.Desc="icon_trigger_desc">
                        <ComboBox c:Cfg.Key="FolderIconTrigger" SelectedIndex="2">
                            <ComboBoxItem c:Cfg.I18n="edge_left"/>
                            <ComboBoxItem c:Cfg.I18n="edge_right"/>
                            <ComboBoxItem c:Cfg.I18n="icon_top"/>
                            <ComboBoxItem c:Cfg.I18n="icon_all"/>
                        </ComboBox>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="long_press_delay" c:Cfg.Desc="long_press_delay_desc" c:Cfg.ShowIf="LongPressOn">
                        <c:Stepper c:Cfg.Key="LongPressDelayMs" Value="300" Min="50" Max="3000" Step="50" Suffix=" ms"/>
                    </c:SettingRow>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Header="行为" c:Cfg.I18n="group_window" Style="{DynamicResource Card}">
                <StackPanel>
                    <c:SettingRow c:Cfg.I18n="close_delay_row" c:Cfg.Desc="close_delay_desc">
                        <c:Stepper c:Cfg.Key="CloseDelay" c:Cfg.Scale="1000" Value="350" Min="0" Max="2000" Step="10" Suffix=" ms"/>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="keep_open" c:Cfg.Desc="keep_open_desc">
                        <ToggleButton c:Cfg.Key="KeepOnLeave" Style="{DynamicResource Switch}"/>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="sort_default" c:Cfg.Desc="sort_default_desc">
                        <ComboBox c:Cfg.Key="SortIndex" c:Cfg.Mode="Sort" SelectedIndex="0"/>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="row_swap" c:Cfg.Desc="row_swap_desc">
                        <ToggleButton c:Cfg.Key="RowSwapSides" Style="{DynamicResource Switch}"/>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="row_hide_band_line" c:Cfg.Desc="row_hide_band_line_desc" c:Cfg.ShowIf="RowSwapOn">
                        <ToggleButton c:Cfg.Key="RowHideBandLine" Style="{DynamicResource Switch}"/>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="status_filter" c:Cfg.Desc="status_filter_desc">
                        <ToggleButton c:Cfg.Key="StatusFilter" Style="{DynamicResource Switch}" IsChecked="True"/>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="show_resource" c:Cfg.Desc="show_resource_desc">
                        <ToggleButton c:Cfg.Key="ShowResourceUsage" Style="{DynamicResource Switch}"/>
                    </c:SettingRow>
                    <Border Style="{DynamicResource Hint}"><TextBlock c:Cfg.I18n="hint_dbl_click" Foreground="{DynamicResource HintTextBrush}"/></Border>
                    <Border Style="{DynamicResource Hint}"><TextBlock c:Cfg.I18n="hint_ctrl_wheel" Foreground="{DynamicResource HintTextBrush}"/></Border>
                    <Border Style="{DynamicResource Hint}"><TextBlock c:Cfg.I18n="kb_hint" Foreground="{DynamicResource HintTextBrush}"/></Border>
                </StackPanel>
            </HeaderedContentControl>
        </StackPanel>
    </DataTemplate>

    <!-- ============ 预览窗口 ============ -->
    <DataTemplate x:Key="PreviewPage">
        <StackPanel>
            <TextBlock Margin="0,0,2,10" HorizontalAlignment="Right"><Hyperlink c:Cfg.Link="https://b23.tv/hVdEGrA">@成熟的剪辑猿</Hyperlink>  <Hyperlink c:Cfg.Link="https://github.com/akahoz94">GitHub</Hyperlink></TextBlock>
            <!-- 通用预览选项：无具体类型归属的项（触发位置 / 解码器） -->
            <HeaderedContentControl Header="预览选项" c:Cfg.I18n="group_preview_opts" Style="{DynamicResource Card}">
                <StackPanel>
                    <c:SettingRow c:Cfg.I18n="file_preview" c:Cfg.Desc="mode_desc">
                        <ComboBox c:Cfg.Key="PreviewMode" SelectedIndex="0">
                            <ComboBoxItem c:Cfg.I18n="mode_off"/>
                            <ComboBoxItem c:Cfg.I18n="mode_always"/>
                            <ComboBoxItem c:Cfg.I18n="mode_ctrl"/>
                            <ComboBoxItem c:Cfg.I18n="mode_shift"/>
                            <ComboBoxItem c:Cfg.I18n="mode_alt"/>
                            <ComboBoxItem c:Cfg.I18n="mode_long_press"/>
                        </ComboBox>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="pv_info_bar" c:Cfg.Desc="pv_info_bar_desc">
                        <ToggleButton c:Cfg.Key="PreviewInfoBar" Style="{DynamicResource Switch}" IsChecked="True"/>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="pv_info_bar_font_family" c:Cfg.Desc="pv_info_bar_font_family_desc" c:Cfg.ShowIf="InfoBarOn"><ComboBox c:Cfg.Key="PreviewInfoBarFontName" c:Cfg.Mode="Fonts" Width="220" SelectedIndex="0"/></c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="pv_info_bar_font" c:Cfg.Desc="pv_info_bar_font_desc" c:Cfg.ShowIf="InfoBarOn"><c:Stepper c:Cfg.Key="PreviewInfoBarFontMax" Value="10" Min="6" Max="24"/></c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="pv_edge" c:Cfg.Desc="pv_edge_desc">
                        <ComboBox c:Cfg.Key="PreviewEdgeMode" SelectedIndex="0">
                            <ComboBoxItem c:Cfg.I18n="edge_off"/>
                            <ComboBoxItem c:Cfg.I18n="edge_left"/>
                            <ComboBoxItem c:Cfg.I18n="edge_right"/>
                            <ComboBoxItem c:Cfg.I18n="edge_both"/>
                        </ComboBox>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="pv_edge_width" c:Cfg.ShowIf="EdgeOn"><c:Stepper c:Cfg.Key="PreviewEdgeRatio" Value="30" Min="1" Max="50" Step="1" Suffix=" %"/></c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="space_preview" c:Cfg.Desc="space_preview_desc"><ToggleButton c:Cfg.Key="SpacePreviewEnabled" Style="{DynamicResource Switch}" IsChecked="False"/></c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="icon_trigger" c:Cfg.Desc="icon_trigger_desc">
                        <ComboBox c:Cfg.Key="PreviewIconTrigger" SelectedIndex="2">
                            <ComboBoxItem c:Cfg.I18n="edge_left"/>
                            <ComboBoxItem c:Cfg.I18n="edge_right"/>
                            <ComboBoxItem c:Cfg.I18n="icon_top"/>
                            <ComboBoxItem c:Cfg.I18n="icon_all"/>
                        </ComboBox>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="icon_trigger_width" c:Cfg.Desc="icon_trigger_width_desc">
                        <c:Stepper c:Cfg.Key="IconTriggerWidth" Value="0" Min="0" Max="400" Step="4" Suffix=" px"/>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="ffmpeg_path_row" c:Cfg.Desc="ffmpeg_path_desc">
                        <StackPanel Orientation="Horizontal">
                            <TextBox c:Cfg.Key="FfmpegPath" Width="150" Margin="0,0,6,0"/>
                            <Button c:Cfg.I18n="ffmpeg_auto" c:Cfg.Action="ffmpeg:auto"/>
                        </StackPanel>
                    </c:SettingRow>
                    <TextBlock Style="{DynamicResource Desc}" Margin="14,2,14,4" c:Cfg.Key="FfmpegStatus"/>
                </StackPanel>
            </HeaderedContentControl>

            <!-- 类型开关为父级，其专属选项为带强调色的从属子项，随父开关显隐 -->
            <HeaderedContentControl Header="预览内容类型" c:Cfg.I18n="group_preview_types_full" Style="{DynamicResource Card}">
                <StackPanel Margin="14,8,14,10">
                    <c:SettingRow c:Cfg.I18n="pv_type_image"><ToggleButton c:Cfg.Key="PreviewImage" Style="{DynamicResource Switch}" IsChecked="True"/></c:SettingRow>

                    <c:SettingRow c:Cfg.I18n="pv_type_video"><ToggleButton c:Cfg.Key="PreviewVideo" Style="{DynamicResource Switch}" IsChecked="True"/></c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="speed_control" c:Cfg.ShowIf="VideoOn"><ToggleButton c:Cfg.Key="VideoSpeedToggle" Style="{DynamicResource Switch}"/></c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="mute_video" c:Cfg.Desc="mute_video_desc" c:Cfg.ShowIf="VideoOn"><ToggleButton c:Cfg.Key="PreviewMuted" Style="{DynamicResource Switch}"/></c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="pv_video_delay" c:Cfg.Desc="pv_video_delay_desc" c:Cfg.ShowIf="VideoOn">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton c:Cfg.Key="VideoPreviewDelayEnabled" Style="{DynamicResource Switch}" Margin="0,0,8,0"/>
                            <c:Stepper c:Cfg.Key="VideoPreviewDelay" Value="0.8" Min="0" Max="5" Step="0.1" Format="0.00" Suffix=" 秒" c:Cfg.ShowIf="VideoDelayOn"/>
                        </StackPanel>
                    </c:SettingRow>

                    <c:SettingRow c:Cfg.I18n="pv_type_audio"><ToggleButton c:Cfg.Key="PreviewAudio" Style="{DynamicResource Switch}" IsChecked="True"/></c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="speed_control" c:Cfg.ShowIf="AudioPreviewOn"><ToggleButton c:Cfg.Key="AudioSpeedToggle" Style="{DynamicResource Switch}"/></c:SettingRow>
                    <!-- 可视化：无/波形/频谱 单选分段（仿原型 .seg） -->
                    <c:SettingRow c:Cfg.I18n="pv_viz" c:Cfg.Desc="pv_viz_desc" c:Cfg.ShowIf="AudioPreviewOn">
                        <Border CornerRadius="8" Background="{DynamicResource SegBrush}" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="6" Background="{DynamicResource PanelBrush}" c:Cfg.ShowIf="VizNone">
                                    <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.18" Color="#000000"/></Border.Effect>
                                    <Button c:Cfg.I18n="viz_none" c:Cfg.Action="viz:none" Style="{DynamicResource SegBtn}" FontWeight="SemiBold"/>
                                </Border>
                                <Button c:Cfg.ShowIf="VizNotNone" c:Cfg.I18n="viz_none" c:Cfg.Action="viz:none" Style="{DynamicResource SegBtn}" Foreground="{DynamicResource SubTextBrush}"/>
                                <Border CornerRadius="6" Background="{DynamicResource PanelBrush}" c:Cfg.ShowIf="VizWave">
                                    <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.18" Color="#000000"/></Border.Effect>
                                    <Button c:Cfg.I18n="viz_wave" c:Cfg.Action="viz:wave" Style="{DynamicResource SegBtn}" FontWeight="SemiBold"/>
                                </Border>
                                <Button c:Cfg.ShowIf="VizNotWave" c:Cfg.I18n="viz_wave" c:Cfg.Action="viz:wave" Style="{DynamicResource SegBtn}" Foreground="{DynamicResource SubTextBrush}"/>
                                <Border CornerRadius="6" Background="{DynamicResource PanelBrush}" c:Cfg.ShowIf="VizSpec">
                                    <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.18" Color="#000000"/></Border.Effect>
                                    <Button c:Cfg.I18n="viz_spec" c:Cfg.Action="viz:spec" Style="{DynamicResource SegBtn}" FontWeight="SemiBold"/>
                                </Border>
                                <Button c:Cfg.ShowIf="VizNotSpec" c:Cfg.I18n="viz_spec" c:Cfg.Action="viz:spec" Style="{DynamicResource SegBtn}" Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </c:SettingRow>
                    <Border Style="{DynamicResource Hint}" c:Cfg.ShowIf="AudioPreviewOn"><TextBlock c:Cfg.I18n="hint_audio_wheel" Foreground="{DynamicResource HintTextBrush}"/></Border>

                    <c:SettingRow c:Cfg.I18n="pv_type_document"><ToggleButton c:Cfg.Key="PreviewDocument" Style="{DynamicResource Switch}" IsChecked="True"/></c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="pv_type_text"><ToggleButton c:Cfg.Key="PreviewText" Style="{DynamicResource Switch}" IsChecked="True"/></c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="pv_type_archive"><ToggleButton c:Cfg.Key="PreviewArchive" Style="{DynamicResource Switch}" IsChecked="True"/></c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="pv_type_font"><ToggleButton c:Cfg.Key="PreviewFont" Style="{DynamicResource Switch}" IsChecked="True"/></c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="pv_type_other"><ToggleButton c:Cfg.Key="PreviewOther" Style="{DynamicResource Switch}" IsChecked="True"/></c:SettingRow>
                </StackPanel>
            </HeaderedContentControl>
        </StackPanel>
    </DataTemplate>

    <!-- ============ 悬停预览（方案C：单页分段，文件夹/文件各自存储触发区） ============ -->
    <DataTemplate x:Key="HoverPreviewPage">
        <StackPanel>
            <TextBlock Margin="0,0,2,10" HorizontalAlignment="Right"><Hyperlink c:Cfg.Link="https://b23.tv/hVdEGrA">@成熟的剪辑猿</Hyperlink>  <Hyperlink c:Cfg.Link="https://github.com/akahoz94">GitHub</Hyperlink></TextBlock>

            <!-- 触发（文件夹与文件共用） -->
            <HeaderedContentControl c:Cfg.I18n="trigger_common" Style="{DynamicResource Card}">
                <StackPanel>
                    <c:SettingRow c:Cfg.I18n="hotkey_row" c:Cfg.Desc="hotkey_desc">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton c:Cfg.Key="HotkeyEnabled" Style="{DynamicResource Switch}" Margin="0,0,10,0"/>
                            <!-- 键帽组：点击重新录制，× 清除 -->
                            <Border Style="{DynamicResource KeyCapGroup}" c:Cfg.ShowIf="HotkeyOn" c:Cfg.Action="hk:main:reset">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{DynamicResource KeyCap}"><TextBlock c:Cfg.Key="HkMain:0" Text="Ctrl" HorizontalAlignment="Center"/></Border>
                                    <Border Style="{DynamicResource KeyCap}"><TextBlock c:Cfg.Key="HkMain:1" Text="Alt" HorizontalAlignment="Center"/></Border>
                                    <Border Style="{DynamicResource KeyCap}"><TextBlock c:Cfg.Key="HkMain:2" Text="Q" HorizontalAlignment="Center"/></Border>
                                    <Button Style="{DynamicResource KeyCapClear}" c:Cfg.Action="hk:main:del"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="pause_zone_row" c:Cfg.Key="PauseRectInfo">
                        <StackPanel Orientation="Horizontal">
                            <Button c:Cfg.I18n="area_clear" c:Cfg.Action="pause:clear" Margin="0,0,6,0"/>
                            <Button c:Cfg.I18n="area_pick" c:Cfg.Action="pause:pick"/>
                        </StackPanel>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="pause_delay_row" c:Cfg.Desc="pause_delay_desc" c:Cfg.ShowIf="PauseRectSet">
                        <c:Stepper c:Cfg.Key="PauseRectDelayMs" Value="200" Min="0" Max="2000" Step="50" Suffix=" ms"/>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="delay_row" c:Cfg.Desc="hover_delay_desc">
                        <c:Stepper c:Cfg.Key="HoverDelay" Value="0.3" Min="0" Max="5" Step="0.05" Format="0.00" Suffix=" 秒"/>
                    </c:SettingRow>
                    <c:SettingRow c:Cfg.I18n="space_preview" c:Cfg.Desc="space_preview_desc"><ToggleButton c:Cfg.Key="SpacePreviewEnabled" Style="{DynamicResource Switch}" IsChecked="False"/></c:SettingRow>
                </StackPanel>
            </HeaderedContentControl>

            <!-- 触发区域：可视化编辑（列表左右两条边 / 图标四边，百分比，文件夹与文件共用） -->
            <HeaderedContentControl c:Cfg.I18n="trigger_zone_common" Style="{DynamicResource Card}">
                <StackPanel Margin="14,10,14,10">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock c:Cfg.I18n="matrix_list_view" Style="{DynamicResource Desc}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <c:UnitSwitch Key="TrigUnitList" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <c:TriggerZoneEditor Kind="list" Height="60"/>
                    <DockPanel Margin="0,12,0,4">
                        <TextBlock c:Cfg.I18n="matrix_icon_view" Style="{DynamicResource Desc}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <c:UnitSwitch Key="TrigUnitIcon" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <c:TriggerZoneEditor Kind="icon" Height="130"/>
                    <TextBlock c:Cfg.I18n="trigger_zone_visual_desc" Style="{DynamicResource Desc}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </HeaderedContentControl>

            <!-- 分段切换：仿原型胶囊分段控件；DOM 顺序固定为“文件夹、文件”，激活态只换样式不改位置 -->
            <Border CornerRadius="8" Background="{DynamicResource SegBrush}" Padding="3" HorizontalAlignment="Left" Margin="4,14,4,10">
                <StackPanel Orientation="Horizontal">
                    <!-- 文件夹（选中态）：白底 + 阴影 -->
                    <Border CornerRadius="6" Background="{DynamicResource PanelBrush}" c:Cfg.ShowIf="SegFolder">
                        <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.18" Color="#000000"/></Border.Effect>
                        <Button c:Cfg.I18n="seg_folder" c:Cfg.Action="seg:folder" Style="{DynamicResource SegBtn}" FontWeight="SemiBold"/>
                    </Border>
                    <!-- 文件夹（未选中态）：文件段激活时显示，位置仍在左侧 -->
                    <Button c:Cfg.ShowIf="SegFile" c:Cfg.I18n="seg_folder" c:Cfg.Action="seg:folder" Style="{DynamicResource SegBtn}"
                            Foreground="{DynamicResource SubTextBrush}"/>
                    <!-- 文件（未选中态） -->
                    <Button c:Cfg.ShowIf="SegFolder" c:Cfg.I18n="seg_file" c:Cfg.Action="seg:file" Style="{DynamicResource SegBtn}"
                            Foreground="{DynamicResource SubTextBrush}"/>
                    <!-- 文件（选中态）：白底 + 阴影 -->
                    <Border CornerRadius="6" Background="{DynamicResource PanelBrush}" c:Cfg.ShowIf="SegFile">
                        <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.18" Color="#000000"/></Border.Effect>
                        <Button c:Cfg.I18n="seg_file" c:Cfg.Action="seg:file" Style="{DynamicResource SegBtn}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== 文件夹段 ===== -->
            <StackPanel c:Cfg.ShowIf="SegFolder">
                <HeaderedContentControl Header="文件夹预览" c:Cfg.I18n="nav_preview_list" Style="{DynamicResource Card}">
                    <StackPanel>
                        <c:SettingRow c:Cfg.I18n="explorer_hover" c:Cfg.Desc="mode_desc">
                            <ComboBox c:Cfg.Key="ExplorerMode" SelectedIndex="0">
                                <ComboBoxItem c:Cfg.I18n="mode_off"/><ComboBoxItem c:Cfg.I18n="mode_always"/>
                                <ComboBoxItem c:Cfg.I18n="mode_ctrl"/><ComboBoxItem c:Cfg.I18n="mode_shift"/>
                                <ComboBoxItem c:Cfg.I18n="mode_alt"/><ComboBoxItem c:Cfg.I18n="mode_long_press"/>
                            </ComboBox>
                        </c:SettingRow>
                        <c:SettingRow c:Cfg.I18n="close_delay_row" c:Cfg.Desc="close_delay_desc">
                            <c:Stepper c:Cfg.Key="CloseDelay" c:Cfg.Scale="1000" Value="350" Min="0" Max="2000" Step="10" Suffix=" ms"/>
                        </c:SettingRow>
                        <c:SettingRow c:Cfg.I18n="keep_open" c:Cfg.Desc="keep_open_desc">
                            <ToggleButton c:Cfg.Key="KeepOnLeave" Style="{DynamicResource Switch}"/>
                        </c:SettingRow>
                        <c:SettingRow c:Cfg.I18n="long_press_delay" c:Cfg.Desc="long_press_delay_desc" c:Cfg.ShowIf="LongPressOn">
                            <c:Stepper c:Cfg.Key="LongPressDelayMs" Value="300" Min="50" Max="3000" Step="50" Suffix=" ms"/>
                        </c:SettingRow>
                        <c:SettingRow c:Cfg.I18n="sort_default" c:Cfg.Desc="sort_default_desc">
                            <ComboBox c:Cfg.Key="SortIndex" c:Cfg.Mode="Sort" SelectedIndex="0"/>
                        </c:SettingRow>
                        <c:SettingRow c:Cfg.I18n="row_hide_band_line" c:Cfg.Desc="row_hide_band_line_desc" c:Cfg.ShowIf="RowSwapOn">
                            <ToggleButton c:Cfg.Key="RowHideBandLine" Style="{DynamicResource Switch}"/>
                        </c:SettingRow>
                        <c:SettingRow c:Cfg.I18n="status_filter" c:Cfg.Desc="status_filter_desc">
                            <ToggleButton c:Cfg.Key="StatusFilter" Style="{DynamicResource Switch}" IsChecked="True"/>
                        </c:SettingRow>
                        <c:SettingRow c:Cfg.I18n="show_resource" c:Cfg.Desc="show_resource_desc">
                            <ToggleButton c:Cfg.Key="ShowResourceUsage" Style="{DynamicResource Switch}"/>
                        </c:SettingRow>
                        <Border Style="{DynamicResource Hint}"><TextBlock c:Cfg.I18n="hint_dbl_click" Foreground="{DynamicResource HintTextBrush}"/></Border>
                        <Border Style="{DynamicResource Hint}"><TextBlock c:Cfg.I18n="hint_ctrl_wheel" Foreground="{DynamicResource HintTextBrush}"/></Border>
                        <Border Style="{DynamicResource Hint}"><TextBlock c:Cfg.I18n="kb_hint" Foreground="{DynamicResource HintTextBrush}"/></Border>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- 列表外观（原独立导航页，移入“文件夹预览”下方） -->
                <HeaderedContentControl Header="自定义颜色" c:Cfg.I18n="list_palette" Style="{DynamicResource Card}">
                    <StackPanel>
                        <!-- 方案工具条：方案选择在左，操作按钮右对齐 -->
                        <StackPanel Orientation="Horizontal" Margin="14,8,14,10">
                            <TextBlock c:Cfg.I18n="palette_scheme" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SubTextBrush}"/>
                            <ComboBox x:Name="ListSchemeCombo" Width="150" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <Button c:Cfg.I18n="clear" c:Cfg.Action="palette:clear" Margin="0,0,6,0"/>
                            <Button c:Cfg.I18n="save_as" c:Cfg.Action="palette:save" Margin="0,0,6,0"/>
                            <Button c:Cfg.I18n="del_scheme" c:Cfg.Action="palette:del" Margin="0,0,6,0"/>
                            <Button c:Cfg.I18n="paste_import" c:Cfg.Action="palette:paste" Style="{DynamicResource PrimaryButton}"/>
                        </StackPanel>

                        <!-- 颜色/字体表格（项目 | 颜色 | 字体 | 字号），无实时预览 -->
                        <c:AppearanceTable Margin="0,0,0,6"/>
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>

            <!-- ===== 文件段 ===== -->
            <StackPanel c:Cfg.ShowIf="SegFile">
                <HeaderedContentControl Header="文件预览" c:Cfg.I18n="group_content" Style="{DynamicResource Card}">
                    <StackPanel>
                        <c:SettingRow c:Cfg.I18n="file_preview" c:Cfg.Desc="mode_desc">
                            <ComboBox c:Cfg.Key="PreviewMode" SelectedIndex="0">
                                <ComboBoxItem c:Cfg.I18n="mode_off"/><ComboBoxItem c:Cfg.I18n="mode_always"/>
                                <ComboBoxItem c:Cfg.I18n="mode_ctrl"/><ComboBoxItem c:Cfg.I18n="mode_shift"/>
                                <ComboBoxItem c:Cfg.I18n="mode_alt"/><ComboBoxItem c:Cfg.I18n="mode_long_press"/>
                            </ComboBox>
                        </c:SettingRow>
                        <c:SettingRow c:Cfg.I18n="pv_info_bar" c:Cfg.Desc="pv_info_bar_desc">
                            <ToggleButton c:Cfg.Key="PreviewInfoBar" Style="{DynamicResource Switch}" IsChecked="True"/>
                        </c:SettingRow>
                        <c:SettingRow c:Cfg.I18n="pv_info_bar_font_family" c:Cfg.Desc="pv_info_bar_font_family_desc" c:Cfg.ShowIf="InfoBarOn"><ComboBox c:Cfg.Key="PreviewInfoBarFontName" c:Cfg.Mode="Fonts" Width="220" SelectedIndex="0"/></c:SettingRow>
                        <c:SettingRow c:Cfg.I18n="pv_info_bar_font" c:Cfg.Desc="pv_info_bar_font_desc" c:Cfg.ShowIf="InfoBarOn"><c:Stepper c:Cfg.Key="PreviewInfoBarFontMax" Value="10" Min="6" Max="24"/></c:SettingRow>
                        <c:SettingRow c:Cfg.I18n="ffmpeg_path_row" c:Cfg.Desc="ffmpeg_path_desc">
                            <StackPanel Orientation="Horizontal">
                                <TextBox c:Cfg.Key="FfmpegPath" Width="150" Margin="0,0,6,0"/>
                                <Button c:Cfg.I18n="ffmpeg_auto" c:Cfg.Action="ffmpeg:auto"/>
                            </StackPanel>
                        </c:SettingRow>
                        <TextBlock Style="{DynamicResource Desc}" Margin="14,2,14,4" c:Cfg.Key="FfmpegStatus"/>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Header="预览内容类型" c:Cfg.I18n="group_preview_types_full" Style="{DynamicResource Card}">
                    <StackPanel Margin="14,10,14,10">
                        <!-- 类型 chip：可多选，选中描边+着色（原型风格） -->
                        <WrapPanel>
                            <ToggleButton c:Cfg.Key="PreviewImage" c:Cfg.I18n="pv_type_image" Style="{DynamicResource Chip}" IsChecked="True"/>
                            <ToggleButton c:Cfg.Key="PreviewVideo" c:Cfg.I18n="pv_type_video" Style="{DynamicResource Chip}" IsChecked="True"/>
                            <ToggleButton c:Cfg.Key="PreviewAudio" c:Cfg.I18n="pv_type_audio" Style="{DynamicResource Chip}" IsChecked="True"/>
                            <ToggleButton c:Cfg.Key="PreviewDocument" c:Cfg.I18n="pv_type_document" Style="{DynamicResource Chip}" IsChecked="True"/>
                            <ToggleButton c:Cfg.Key="PreviewText" c:Cfg.I18n="pv_type_text" Style="{DynamicResource Chip}" IsChecked="True"/>
                            <ToggleButton c:Cfg.Key="PreviewArchive" c:Cfg.I18n="pv_type_archive" Style="{DynamicResource Chip}" IsChecked="True"/>
                            <ToggleButton c:Cfg.Key="PreviewFont" c:Cfg.I18n="pv_type_font" Style="{DynamicResource Chip}" IsChecked="True"/>
                            <ToggleButton c:Cfg.Key="PreviewOther" c:Cfg.I18n="pv_type_other" Style="{DynamicResource Chip}" IsChecked="True"/>
                        </WrapPanel>

                        <!-- 视频 / 音频子选项：默认折叠，避免内容类型卡片过长 -->
                        <Expander Margin="0,8,0,0" IsExpanded="False" Foreground="{DynamicResource TextBrush}">
                            <Expander.Header>
                                <TextBlock Text="视频 / 音频子选项" c:Cfg.I18n="sub_video_audio" FontWeight="SemiBold" Margin="0,2,0,2"/>
                            </Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                                <c:SettingRow c:Cfg.I18n="speed_control" c:Cfg.ShowIf="VideoOn"><ToggleButton c:Cfg.Key="VideoSpeedToggle" Style="{DynamicResource Switch}"/></c:SettingRow>
                                <c:SettingRow c:Cfg.I18n="mute_video" c:Cfg.Desc="mute_video_desc" c:Cfg.ShowIf="VideoOn"><ToggleButton c:Cfg.Key="PreviewMuted" Style="{DynamicResource Switch}"/></c:SettingRow>
                                <c:SettingRow c:Cfg.I18n="pv_video_delay" c:Cfg.Desc="pv_video_delay_desc" c:Cfg.ShowIf="VideoOn">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton c:Cfg.Key="VideoPreviewDelayEnabled" Style="{DynamicResource Switch}" Margin="0,0,8,0"/>
                                        <c:Stepper c:Cfg.Key="VideoPreviewDelay" Value="0.8" Min="0" Max="5" Step="0.1" Format="0.00" Suffix=" 秒" c:Cfg.ShowIf="VideoDelayOn"/>
                                    </StackPanel>
                                </c:SettingRow>
                                <c:SettingRow c:Cfg.I18n="speed_control" c:Cfg.ShowIf="AudioPreviewOn"><ToggleButton c:Cfg.Key="AudioSpeedToggle" Style="{DynamicResource Switch}"/></c:SettingRow>
                                <!-- 可视化：无/波形/频谱 单选分段（仿原型 .seg） -->
                                <c:SettingRow c:Cfg.I18n="pv_viz" c:Cfg.Desc="pv_viz_desc" c:Cfg.ShowIf="AudioPreviewOn">
                                    <Border CornerRadius="8" Background="{DynamicResource SegBrush}" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <Border CornerRadius="6" Background="{DynamicResource PanelBrush}" c:Cfg.ShowIf="VizNone">
                                                <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.18" Color="#000000"/></Border.Effect>
                                                <Button c:Cfg.I18n="viz_none" c:Cfg.Action="viz:none" Style="{DynamicResource SegBtn}" FontWeight="SemiBold"/>
                                            </Border>
                                            <Button c:Cfg.ShowIf="VizNotNone" c:Cfg.I18n="viz_none" c:Cfg.Action="viz:none" Style="{DynamicResource SegBtn}" Foreground="{DynamicResource SubTextBrush}"/>
                                            <Border CornerRadius="6" Background="{DynamicResource PanelBrush}" c:Cfg.ShowIf="VizWave">
                                                <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.18" Color="#000000"/></Border.Effect>
                                                <Button c:Cfg.I18n="viz_wave" c:Cfg.Action="viz:wave" Style="{DynamicResource SegBtn}" FontWeight="SemiBold"/>
                                            </Border>
                                            <Button c:Cfg.ShowIf="VizNotWave" c:Cfg.I18n="viz_wave" c:Cfg.Action="viz:wave" Style="{DynamicResource SegBtn}" Foreground="{DynamicResource SubTextBrush}"/>
                                            <Border CornerRadius="6" Background="{DynamicResource PanelBrush}" c:Cfg.ShowIf="VizSpec">
                                                <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.18" Color="#000000"/></Border.Effect>
                                                <Button c:Cfg.I18n="viz_spec" c:Cfg.Action="viz:spec" Style="{DynamicResource SegBtn}" FontWeight="SemiBold"/>
                                            </Border>
                                            <Button c:Cfg.ShowIf="VizNotSpec" c:Cfg.I18n="viz_spec" c:Cfg.Action="viz:spec" Style="{DynamicResource SegBtn}" Foreground="{DynamicResource SubTextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </c:SettingRow>
                                <Border Style="{DynamicResource Hint}" c:Cfg.ShowIf="AudioPreviewOn"><TextBlock c:Cfg.I18n="hint_audio_wheel" Foreground="{DynamicResource HintTextBrush}"/></Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>

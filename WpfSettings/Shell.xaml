<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HoverExplorer.Wpf;assembly=HoverExplorer"
        Title="HoverExplorer" Width="700" Height="880" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：左侧语言分段按钮，右侧主题分段按钮 -->
        <Border Background="{DynamicResource HeaderBrush}">
            <Grid Margin="14,0,14,0">
                <ContentControl x:Name="LangHost" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <ContentControl x:Name="ThemeHost" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 导航：撑满整列高度，1px 实线分隔 -->
            <Border Background="{DynamicResource NavBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <StackPanel x:Name="NavPanel" Margin="0,12,0,0">
                    <RadioButton Content="悬停预览" c:Cfg.I18n="nav_hover_preview" Tag="HoverPreviewPage" Style="{DynamicResource NavItem}" IsChecked="True"/>
                    <RadioButton Content="桌面卡片" c:Cfg.I18n="group_card" Tag="CardPage" Style="{DynamicResource NavItem}"/>
                    <RadioButton Content="历史•收藏" c:Cfg.I18n="group_entry" Tag="HistoryPage" Style="{DynamicResource NavItem}"/>
                    <RadioButton Content="高级与集成" c:Cfg.I18n="group_advanced" Tag="AdvancedPage" Style="{DynamicResource NavItem}"/>
                    <RadioButton Content="关于" c:Cfg.I18n="group_about" Tag="AboutPage" Style="{DynamicResource NavItem}"/>
                </StackPanel>
            </Border>

            <!-- 页面 -->
            <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="PageHost" Margin="26,14,26,20" IsTabStop="False"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:HoverExplorer.Wpf;assembly=HoverExplorer">

    <!-- 说明文字 -->
    <Style x:Key="Desc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- 无边框扁平按钮（步进器用） -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource ChipHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 默认按钮 -->
    <Style TargetType="Button">
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{DynamicResource ChipBrush}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource ChipHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 顶栏分段按钮：无默认边框/底，由代码里 SetResourceReference 控制激活态 -->
    <Style x:Key="SegmentButton" TargetType="Button">
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 输入框 -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 开关 -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource TrackOffBrush}"/>
                        <Ellipse Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="Tt" X="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Tt" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Tt" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 键帽 -->
    <!-- 快捷键键帽：浅灰底 + 细描边 + 轻投影 -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ChipBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="Margin" Value="3,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Effect">
            <Setter.Value><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.10" Color="#000000"/></Setter.Value>
        </Setter>
    </Style>

    <!-- 键帽组外框：描边胶囊，点击重新录制 -->
    <Style x:Key="KeyCapGroup" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="3,3,1,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 键帽组内的清除按钮（×） -->
    <Style x:Key="KeyCapClear" TargetType="Button">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Margin" Value="4,0,3,0"/>
        <Setter Property="Content" Value="✕"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 黄色提示条 -->
    <Style x:Key="Hint" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HintBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="14,4"/>
    </Style>

    <!-- 分组卡片 -->
    <Style x:Key="Card" TargetType="HeaderedContentControl">
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <Border Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0" Padding="14,9">
                                <StackPanel Orientation="Horizontal" TextElement.FontWeight="SemiBold">
                                    <Rectangle Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Margin="0,1,9,0"/>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ContentPresenter Margin="0,6,0,8"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 左侧导航 -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="GroupName" Value="nav"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="8,0,8,2"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="g">
                        <Border x:Name="bg" CornerRadius="6" Background="Transparent"/>
                        <Rectangle x:Name="bar" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                                   HorizontalAlignment="Left" Margin="0,0,0,0" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="18,0,6,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource ChipOnBrush}"/>
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavSub" TargetType="RadioButton" BasedOn="{StaticResource NavItem}">
        <Setter Property="Margin" Value="18,0,8,2"/>
    </Style>

    <!-- 下拉框 -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="3,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource ChipHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="130"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="tb" Background="{DynamicResource ChipBrush}" CornerRadius="4">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                              Data="M0,0 L3.5,3.5 L7,0" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.3"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tb" Property="Background" Value="{DynamicResource ChipHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="10,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, ElementName=Toggle}" Margin="0,2,8,8"
                                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5"
                                    TextElement.Foreground="{DynamicResource TextBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                                </Border.Effect>
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="0,3">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 设置项：标题 + 说明 + 右侧控件；从属项（上层开关控制显隐）带左侧强调色条 + 浅底 -->
    <Style TargetType="c:SettingRow">
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SettingRow">
                    <Grid Margin="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="accent" Width="3" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource AccentBrush}" Margin="0,2,9,2" Visibility="Collapsed"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{TemplateBinding Title}" FontSize="12.5"/>
                            <TextBlock x:Name="desc" Text="{TemplateBinding Description}" Style="{StaticResource Desc}"/>
                        </StackPanel>
                        <ContentPresenter Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Cfg.Subordinate" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubordinateTint}"/>
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="desc" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 数值步进器：C# 自定义控件 + ControlTemplate（松散 XAML 不支持 UserControl 的 x:Class） -->
    <Style TargetType="{x:Type c:Stepper}">
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:Stepper}">
                    <Border Background="{DynamicResource ChipBrush}" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PART_Minus" Content="−" Style="{DynamicResource FlatButton}"/>
                            <TextBox x:Name="PART_Input" Grid.Column="1" HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center" BorderThickness="0"
                                     Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                     CaretBrush="{DynamicResource TextBrush}"/>
                            <!-- 单位后缀（px/%），点击切换；未设 UnitKey 时折叠 -->
                            <Button x:Name="PART_Unit" Grid.Column="2" Style="{DynamicResource FlatButton}"
                                    MinWidth="0" Padding="6,0" Height="26" FontSize="11"
                                    Content="{Binding UnitText, RelativeSource={RelativeSource TemplatedParent}}"
                                    Foreground="{DynamicResource SubTextBrush}" Cursor="Hand"/>
                            <Button x:Name="PART_Plus" Grid.Column="3" Content="+" Style="{DynamicResource FlatButton}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分段按钮：无边框、无悬停变色，激活态由外层白底 + 阴影表达（原型 .seg button.on） -->
    <Style x:Key="SegBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="26,4"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 内容类型 chip：可多选的胶囊开关（原型风格） -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Padding" Value="14,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipOnBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 颜色行：标签 + 色块 + 可编辑 hex -->
    <Style TargetType="{x:Type c:ColorRow}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="14,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ColorRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="22" Height="22" HorizontalAlignment="Left" CornerRadius="3"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Background="{Binding Brush, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <TextBox x:Name="PART_Text" Grid.Column="2" MinWidth="120" Margin="0,0,8,0" HorizontalAlignment="Stretch"
                                 FontFamily="Consolas"
                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <!-- 屏幕取色：十字准星图标（不依赖字体字形，避免显示成文字/缺字）
                             用 FlatButton 并清掉全局按钮的 MinWidth=64，否则会被撑宽/挤出右边缘 -->
                        <Button x:Name="PART_Pick" Grid.Column="3" Width="26" Height="22" MinWidth="0" Margin="0,0,6,0"
                                Padding="0" Style="{DynamicResource FlatButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="屏幕取色（点击进入，再次点击选中，WASD 微调）">
                            <Grid Width="14" Height="14">
                                <Rectangle Width="1.5" Height="14" RadiusX="0.75" RadiusY="0.75" Fill="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                                <Rectangle Width="14" Height="1.5" RadiusX="0.75" RadiusY="0.75" Fill="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                <Ellipse Width="4" Height="4" Stroke="{DynamicResource TextBrush}" StrokeThickness="1"/>
                            </Grid>
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题：沿用同一色相体系，保持层级一致 -->
    <SolidColorBrush x:Key="BgBrush" Color="#191C22"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#212630"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#252B36"/>
    <SolidColorBrush x:Key="NavBrush" Color="#252B36"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#303745"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EDF0F5"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#9AA3B4"/>
    <SolidColorBrush x:Key="LineBrush" Color="#353C49"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5AA9F5"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#303745"/>
    <SolidColorBrush x:Key="ChipHoverBrush" Color="#3C4453"/>
    <SolidColorBrush x:Key="ChipOnBrush" Color="#20374D"/>
    <SolidColorBrush x:Key="SegBrush" Color="#252B36"/>
    <SolidColorBrush x:Key="InputBrush" Color="#1B1F26"/>
    <SolidColorBrush x:Key="InputLineBrush" Color="#6A7382"/>
    <SolidColorBrush x:Key="TrackOffBrush" Color="#4A5260"/>
    <SolidColorBrush x:Key="HintBrush" Color="#5C5320"/>
    <SolidColorBrush x:Key="HintTextBrush" Color="#F5F0C8"/>
    <SolidColorBrush x:Key="SubordinateTint" Color="#1E2B38"/>
</ResourceDictionary>

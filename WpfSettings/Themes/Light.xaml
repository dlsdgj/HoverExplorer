<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 原型新版：左栏/顶栏同色相浅蓝灰，内容区近白，卡片纯白，激活项浅蓝底 -->
    <SolidColorBrush x:Key="BgBrush" Color="#F8F9FC"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#F1F4F9"/>
    <SolidColorBrush x:Key="NavBrush" Color="#F1F4F9"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#E7ECF4"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1F2430"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#6B7385"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E3E7EE"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="ChipHoverBrush" Color="#E1E7F0"/>
    <SolidColorBrush x:Key="ChipOnBrush" Color="#E3EEFB"/>
    <SolidColorBrush x:Key="SegBrush" Color="#F1F4F9"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputLineBrush" Color="#8A93A2"/>
    <SolidColorBrush x:Key="TrackOffBrush" Color="#D2D2D7"/>
    <SolidColorBrush x:Key="HintBrush" Color="#FFF59D"/>
    <SolidColorBrush x:Key="HintTextBrush" Color="#222222"/>
    <SolidColorBrush x:Key="SubordinateTint" Color="#F4F8FD"/>
</ResourceDictionary>
